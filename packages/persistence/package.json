{
  "name": "@scos/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings --ignore-pattern 'src/generated/**' src test tsdown.config.ts",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/bin/seed.js",
    "db:reset": "node dist/bin/confirm-reset.js && prisma migrate reset --force && node dist/bin/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scos/core": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@scos/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "prisma": "7.10.0",
    "tsdown": "0.23.0",
    "vitest": "5.0.1"
  }
}
