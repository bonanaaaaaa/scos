# Local-only example configuration. Copy to .env (./setup.sh does this).
# Values here contain no external credentials.

# --- API server (apps/api, validated at startup) ---------------------------
# Required. PostgreSQL connection string (postgres:// or postgresql:// with a
# host). ./dev.sh overrides it with this worktree's database. Invalid or
# missing values stop the server before it listens; the value is never logged.
DATABASE_URL=postgresql://scos:scos@localhost:5432/scos
# Optional. Integer 0-65535; defaults to 3000 when unset. An empty value
# (`PORT=`) is invalid and stops startup; leave the line commented out instead.
# ./dev.sh starts searching for a free port here.
# PORT=3000

# --- Tests ------------------------------------------------------------------
# Required by `pnpm test:integration` only. Must name the dedicated scos_test
# database and differ from DATABASE_URL; each test file creates and drops its
# own database beside it.
DATABASE_TEST_URL=postgresql://scos_test:scos_test@localhost:5433/scos_test

# --- Telemetry (apps/api, validated at startup) ------------------------------
# All optional. Full reference: docs/observability.md ("Configuration").
# Logs are always Pino JSON on stdout; these settings never enable log export.
# Invalid values stop startup; values are never printed.
#
# true disables the tracing/metrics SDK (logs still written, uncorrelated).
# OTEL_SDK_DISABLED=false
# Resource attributes on every log record, span and metric.
# OTEL_SERVICE_NAME=scos-api
# SERVICE_VERSION=0.0.0
# DEPLOYMENT_ENVIRONMENT=local
# trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info
# Per-signal exporter: otlp | console | none (console is for local use only).
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# Parent-based trace-ID-ratio sampling of new root traces, 0 to 1.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTLP over HTTP with protobuf; required only when an exporter is otlp. The base
# endpoint gets /v1/traces and /v1/metrics appended; the per-signal ones are
# used as-is. No credentials in URLs: use OTEL_EXPORTER_OTLP_HEADERS.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# Bounds in milliseconds (1-3600000). The metric timeout may not exceed the
# interval when metrics are exported.
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_METRIC_EXPORT_TIMEOUT=30000

# --- Cloudflare Worker (apps/api, `pnpm --filter @scos/api dev:worker`) -----
# The Worker does not read this file. Its variables and secrets come from
# apps/api/wrangler.jsonc "vars" and apps/api/.dev.vars locally (template:
# apps/api/.dev.vars.example); the database from the HYPERDRIVE binding, whose
# local target can be overridden with:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://scos:scos@localhost:5432/scos
