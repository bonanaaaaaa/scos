{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Repository-wide rules. Oxlint reads the closest configuration file, so
  // packages without one of their own (apps/api, apps/api-acceptance,
  // packages/persistence) are linted with this file;
  // packages/core/.oxlintrc.json replaces it and repeats the rules below.
  "rules": {
    // No relative imports: every module is named by the workspace package that
    // exports it (@scos/core) or by its package's "imports" map ("#..." in
    // package.json). Module specifiers then read the same wherever they appear,
    // moving a file changes only its own path, and no source can reach into
    // another package's internals. See docs/architecture.md, "Module specifiers".
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\.?/",
            "message": "Relative imports are not allowed: import through the package's \"imports\" map (\"#...\") or the workspace package name (\"@scos/core\"). See docs/architecture.md, \"Module specifiers\"."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Tool configuration and build scripts: their tool loads them by path,
      // outside the module graph, so they address their siblings relatively.
      "files": ["**/vitest.*.mjs", "**/*.config.mjs", "**/build.mjs"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
