{
  "name": "scos",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
