{
  "name": "@scos/api-acceptance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings test vitest.config.mjs vitest.hosted.config.mjs",
    "test:integration": "vitest run",
    "test:hosted": "vitest run --config vitest.hosted.config.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@scos/persistence": "workspace:*",
    "@scos/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "vitest": "4.1.11"
  }
}
