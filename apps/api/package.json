{
  "name": "@scos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/entrypoints/node.ts",
    "dev:worker": "wrangler dev",
    "start": "node dist/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test scripts build.mjs vitest.config.mjs vitest.integration.config.mjs vitest.workers.config.mjs vitest.workers.integration.config.mjs vitest.workers.shared.mjs",
    "test": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.workers.config.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs && vitest run --config vitest.workers.integration.config.mjs",
    "openapi:export": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scos/core": "workspace:*",
    "@scos/persistence": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "hono": "4.13.8",
    "hono-openapi": "1.3.3",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@scos/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-dist": "3.30.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
