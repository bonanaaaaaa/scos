{
  "name": "@scos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test scripts build.mjs vitest.config.mjs vitest.integration.config.mjs",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "openapi:export": "tsx scripts/openapi.ts export",
    "openapi:check": "tsx scripts/openapi.ts check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/standard-validator": "0.4.0",
    "@hono/swagger-ui": "0.6.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scos/core": "workspace:*",
    "@scos/persistence": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "hono": "4.13.8",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@scos/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-dist": "3.30.6",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "vitest": "5.0.1"
  }
}
