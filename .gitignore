# macOS and editor metadata
.DS_Store
.idea/
*.swp

# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Build output and task caches
dist/
.turbo/
*.tsbuildinfo

# Generated Prisma client (rebuilt by the turbo generate task)
packages/persistence/src/generated/

# Secrets and local environment overrides
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Test and coverage artifacts
coverage/
test-results/
playwright-report/

# Wrangler (apps/api Worker): local development state
.wrangler/

# Terraform (infra/): provider caches, state, plans and crash logs are never
# committed; state and plans hold secrets. .terraform.lock.hcl stays tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Local agent state: issue-loop memory and evidence, skills, worktrees
.loop/
.claude/skills/
.claude/agents/
.claude/worktrees/
.agents/skills/
.codex/agents/

# Local issue drafts kept outside version control
docs/issue-drafts/
